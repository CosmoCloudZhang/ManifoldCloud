# Patterns starting with "/" apply at the repository root only.

# --- macOS and editors ----------------------------------------------------
.DS_Store
._*
.vscode/
.idea/
*.swp

# --- Python caches and build products -------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Jupyter --------------------------------------------------------------
.ipynb_checkpoints/

# --- Environments, secrets and per-machine settings -----------------------
.venv/
venv/
.env
.env.*
config/local.toml

# --- Catalogue data and other large products ------------------------------
# Catalogue files are never committed. Figures and tables from production
# runs under outputs/figures and outputs/tables are tracked; the products of
# exploratory runs belong in scratch/.
/outputs/data/
*.parquet
*.hdf5
*.h5
*.fits
*.fits.gz
*.npy
*.npz
*.pkl
*.joblib
*.part
*.log

# --- Scratch --------------------------------------------------------------
# Quick notes, scripts and prompts for one-off tasks. No tracked file may
# depend on anything in this folder.
/scratch/

# --- Teaching material and office files -----------------------------------
# Lecture material is kept outside this repository.
/lectures/
~$*
node_modules/

# --- LaTeX build products in report/ --------------------------------------
report/**/*.aux
report/**/*.bbl
report/**/*.blg
report/**/*.fdb_latexmk
report/**/*.fls
report/**/*.out
report/**/*.synctex.gz
report/**/*.toc
